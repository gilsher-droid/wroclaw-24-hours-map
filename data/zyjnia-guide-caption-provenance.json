    "de": {
      "language": "de",
      "status": "Published",
      "published": true,
      "reopenedVerified": true,
      "videoId": "BAueoGqdcC4",
      "srtFile": "captions/zyjnia-bwa/de.srt",
      "srtSHA256": "acdc7c063cfa0714120f3b3bb15624efa61e4afc335eb20cb735ce94ff54820d",
      "cueCount": 16,
      "cues": [
        {
          "start": 2.7,
          "end": 9.48,
          "text": "Wir sind in der belebten Fußgängerzone\nŚwidnicka."
        },
        {
          "start": 9.9,
          "end": 15.62,
          "text": "Es ist laut und lebendig,\nvoller Menschen und geschäftigem Treiben."
        },
        {
          "start": 16.5,
          "end": 22.32,
          "text": "Wenn ihr jedoch durch diese Tür\nin den Raum hinter mir geht,"
        },
        {
          "start": 22.32,
          "end": 28.28,
          "text": "erreicht ihr ein Stück Himmel,"
        },
        {
          "start": 28.76,
          "end": 32.72,
          "text": "einen Ort der Ruhe,\nan dem ihr entspannen"
        },
        {
          "start": 32.72,
          "end": 37.06,
          "text": "und eine Ausstellung\nmoderner Kunst genießen könnt."
        },
        {
          "start": 38.42,
          "end": 43.1,
          "text": "Es gibt auch Plätze zum Sitzen\nund für eine Tasse Tee,"
        },
        {
          "start": 43.1,
          "end": 47.22,
          "text": "ganz wie im eigenen Wohnzimmer."
        },
        {
          "start": 47.22,
          "end": 51.32,
          "text": "Ruht euch aus und bewundert einfach"
        },
        {
          "start": 51.32,
          "end": 57.4,
          "text": "die schönen Kunstwerke,"
        },
        {
          "start": 57.4,
          "end": 61.06,
          "text": "die euch hier im Raum umgeben."
        },
        {
          "start": 61.96,
          "end": 66.3,
          "text": "Die Ausstellung zeigt\nverschiedene Künstler"
        },
        {
          "start": 66.3,
          "end": 72.44,
          "text": "und ist saisonal,\nsie verändert sich im Laufe des Jahres."
        },
        {
          "start": 72.44,
          "end": 77.6,
          "text": "Ich lade euch also ein,\ndiese großartige Galerie zu besuchen."
        },
        {
          "start": 77.6,
          "end": 78.78,
          "text": "Der Eintritt ist frei."
        },
        {
          "start": 79.52,
          "end": 81.1,
          "text": "Bis zu unserem nächsten Video."
        }
      ],
      "evidence": [
        "docs/zyjnia-guides/de-captions-reopened.txt",
        "docs/zyjnia-guides/de-captions-reopened.png"
      ]
    },
    "cs": {
      "language": "cs",
      "status": "Published",
      "published": true,
      "reopenedVerified": true,
      "videoId": "BAueoGqdcC4",
      "srtFile": "captions/zyjnia-bwa/cs.srt",
      "srtSHA256": "04ee60071389fcc0d5699107f9cfa2d554c791313b0c560a538811d6cc7c267d",
      "cueCount": 16,
      "cues": [
        {
          "start": 2.7,
          "end": 9.48,
          "text": "Jsme na rušné pěší zóně\nv ulici Świdnicka."
        },
        {
          "start": 9.9,
          "end": 15.62,
          "text": "Je tu hluk, živo,\nplno lidí a ruchu."
        },
        {
          "start": 16.5,
          "end": 22.32,
          "text": "Když ale vejdete těmito dveřmi\ndo prostoru za mnou,"
        },
        {
          "start": 22.32,
          "end": 28.28,
          "text": "dostanete se do kousku ráje,"
        },
        {
          "start": 28.76,
          "end": 32.72,
          "text": "do oázy klidu,\nkde si můžete odpočinout"
        },
        {
          "start": 32.72,
          "end": 37.06,
          "text": "a prohlédnout si výstavu\nmoderního umění."
        },
        {
          "start": 38.42,
          "end": 43.1,
          "text": "Jsou tu také místa k posezení\na k vychutnání šálku čaje,"
        },
        {
          "start": 43.1,
          "end": 47.22,
          "text": "jako byste byli\nve vlastním obývacím pokoji."
        },
        {
          "start": 47.22,
          "end": 51.32,
          "text": "Odpočívejte a prostě obdivujte"
        },
        {
          "start": 51.32,
          "end": 57.4,
          "text": "krásná umělecká díla,"
        },
        {
          "start": 57.4,
          "end": 61.06,
          "text": "která vás v tomto prostoru obklopují."
        },
        {
          "start": 61.96,
          "end": 66.3,
          "text": "Výstava představuje\nrůzné umělce"
        },
        {
          "start": 66.3,
          "end": 72.44,
          "text": "a je sezónní,\nběhem roku se mění."
        },
        {
          "start": 72.44,
          "end": 77.6,
          "text": "Zvu vás tedy k návštěvě\ntéto úžasné galerie."
        },
        {
          "start": 77.6,
          "end": 78.78,
          "text": "Vstup je zdarma."
        },
        {
          "start": 79.52,
          "end": 81.1,
          "text": "Uvidíme se v našem dalším videu."
        }
      ],
