    "he": {
      "language": "he",
      "status": "Published",
      "published": true,
      "reopenedVerified": true,
      "videoId": "ZO-A54BIZQk",
      "srtFile": "captions/zyjnia-bwa/he.srt",
      "srtSHA256": "fc040e3bef33f31a77351427b25babe81a432228ccdaeecde82a9c1b5aa38dda",
      "cueCount": 14,
      "cues": [
        {
          "start": 2.38,
          "end": 5.94,
          "text": "אנחנו נמצאים במדרחוב\nשווידניצקה."
        },
        {
          "start": 6.06,
          "end": 10.72,
          "text": "מדרחוב סואן, עמוס באנשים,"
        },
        {
          "start": 11.72,
          "end": 18.66,
          "text": "רועש, אבל בתוך כל הרעש הזה\nוההמולה הזו"
        },
        {
          "start": 18.66,
          "end": 22.68,
          "text": "ניתן להיכנס לגלריה\nשנמצאת פה מאחוריי,"
        },
        {
          "start": 23.57,
          "end": 28.94,
          "text": "שהיא גם גלריה לאמנות עכשווית\nוהיא גם סלון עירוני."
        },
        {
          "start": 29.78,
          "end": 34.56,
          "text": "בפנים אתם תמצאו חלל\nעם מיצגים אמנותיים, אמנותיים,"
        },
        {
          "start": 34.56,
          "end": 39.68,
          "text": "וגם מקומות ישיבה ואפילו\nאפשרות להכין לכם כאן תה."
        },
        {
          "start": 41.2,
          "end": 46.26,
          "text": "ומקומות הישיבה בעצם\nמשולבים בתוך התערוכה,"
        },
        {
          "start": 46.26,
          "end": 49.34,
          "text": "ואתם פשוט מוזמנים\nלשבת ולשתות כוס תה,"
        },
        {
          "start": 49.34,
          "end": 52.3,
          "text": "לנוח רגע מההמולה\nשל העיר הגדולה"
        },
        {
          "start": 52.3,
          "end": 58.56,
          "text": "וליהנות מהשלווה והשקט\nומיצירות האמנות שמקיפות אתכם."
        },
        {
          "start": 58.82,
          "end": 60.22,
          "text": "מומלץ מאוד."
        },
        {
          "start": 60.82,
          "end": 62.58,
          "text": "נתראה בווידאו הבא."
        },
        {
          "start": 62.9,
          "end": 63.66,
          "text": "Do widzenia."
        }
      ],
