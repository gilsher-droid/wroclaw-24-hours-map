    "en": {
      "language": "en",
      "status": "Published",
      "published": true,
      "reopenedVerified": true,
      "videoId": "BAueoGqdcC4",
      "srtFile": "captions/zyjnia-bwa/en.srt",
      "srtSHA256": "26d0bfd6f6ee637a9789150302912c6649663a37d2351bf5d02196079eef54e7",
      "cueCount": 16,
      "cues": [
        {
          "start": 2.7,
          "end": 9.48,
          "text": "We are in the busy pedestrian\nstreet of Świdnicka."
        },
        {
          "start": 9.9,
          "end": 15.62,
          "text": "It's noisy, it's lively,\nit's full of people, it's bustling."
        },
        {
          "start": 16.5,
          "end": 22.32,
          "text": "However, if you walk just inside\nthe space behind me through that door,"
        },
        {
          "start": 22.32,
          "end": 28.28,
          "text": "you will reach a piece of heaven,"
        },
        {
          "start": 28.76,
          "end": 32.72,
          "text": "a piece of serenity\nin which you can relax"
        },
        {
          "start": 32.72,
          "end": 37.06,
          "text": "and enjoy a modern art exhibition"
        },
        {
          "start": 38.42,
          "end": 43.1,
          "text": "and places just to sit\nand enjoy a cup of tea,"
        },
        {
          "start": 43.1,
          "end": 47.22,
          "text": "just like you are\nin your living room."
        },
        {
          "start": 47.22,
          "end": 51.32,
          "text": "Rest and just admire"
        },
        {
          "start": 51.32,
          "end": 57.4,
          "text": "the beautiful artistic artifacts"
        },
        {
          "start": 57.4,
          "end": 61.06,
          "text": "that are around you in the space."
        },
        {
          "start": 61.96,
          "end": 66.3,
          "text": "The exhibition is presenting\ndifferent artists"
        },
        {
          "start": 66.3,
          "end": 72.44,
          "text": "and it's seasonal,\nit's changing through the year."
        },
        {
          "start": 72.44,
          "end": 77.6,
          "text": "So I invite you to visit\nthis amazing gallery"
        },
        {
          "start": 77.6,
          "end": 78.78,
          "text": "and it's for free."
        },
        {
          "start": 79.52,
          "end": 81.1,
          "text": "See you on our next video."
        }
      ],
      "evidence": [
        "docs/zyjnia-guides/en-captions-reopened.txt",
        "docs/zyjnia-guides/en-captions-reopened.png"
      ]
    },
    "pl": {
      "language": "pl",
      "status": "Published",
      "published": true,
      "reopenedVerified": true,
      "videoId": "BAueoGqdcC4",
      "srtFile": "captions/zyjnia-bwa/pl.srt",
      "srtSHA256": "8bd5947f76876c031c56a033cd880723aa43838ec420b882085ef937e0cee5e9",
      "cueCount": 16,
      "cues": [
        {
          "start": 2.7,
          "end": 9.48,
          "text": "Jesteśmy na ruchliwym deptaku\nprzy ulicy Świdnickiej."
        },
        {
          "start": 9.9,
          "end": 15.62,
          "text": "Jest głośno, tętni tu życie,\njest mnóstwo ludzi i ruchu."
        },
        {
          "start": 16.5,
          "end": 22.32,
          "text": "Jeśli jednak wejdziecie do środka,\nprzez te drzwi za mną,"
        },
        {
          "start": 22.32,
          "end": 28.28,
          "text": "znajdziecie kawałek nieba,"
        },
        {
          "start": 28.76,
          "end": 32.72,
          "text": "oazę spokoju,\nw której można odpocząć"
        },
        {
          "start": 32.72,
          "end": 37.06,
          "text": "i obejrzeć wystawę sztuki nowoczesnej"
        },
        {
          "start": 38.42,
          "end": 43.1,
          "text": "oraz miejsca, gdzie można usiąść\ni wypić filiżankę herbaty,"
        },
        {
          "start": 43.1,
          "end": 47.22,
          "text": "zupełnie jak we własnym salonie."
        },
        {
          "start": 47.22,
          "end": 51.32,
          "text": "Odpocząć i po prostu podziwiać"
        },
        {
          "start": 51.32,
          "end": 57.4,
          "text": "piękne dzieła sztuki,"
        },
        {
          "start": 57.4,
          "end": 61.06,
          "text": "które otaczają was w tej przestrzeni."
        },
        {
          "start": 61.96,
          "end": 66.3,
          "text": "Wystawa prezentuje\nróżnych artystów"
        },
        {
          "start": 66.3,
          "end": 72.44,
          "text": "i ma charakter sezonowy,\nzmienia się w ciągu roku."
        },
        {
          "start": 72.44,
          "end": 77.6,
          "text": "Zapraszam więc do odwiedzenia\ntej wspaniałej galerii."
        },
        {
          "start": 77.6,
          "end": 78.78,
          "text": "Wstęp jest bezpłatny."
        },
        {
          "start": 79.52,
          "end": 81.1,
          "text": "Do zobaczenia w naszym kolejnym filmie."
        }
      ],
      "evidence": [
        "docs/zyjnia-guides/pl-captions-reopened.txt",
