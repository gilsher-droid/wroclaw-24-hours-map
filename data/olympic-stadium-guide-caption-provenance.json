      "srtFile": "captions/olympic-stadium/cs.srt",
      "srtSHA256": "5ec83a3dc9c3f8411bf8bff9941fd2ac70e40465d7efa62cdaf3b26cd4f08ec8",
      "cues": [
        {
          "start": 1.74,
          "end": 2.7,
          "text": "Cześć!"
        },
        {
          "start": 3.22,
          "end": 7.86,
          "text": "Ahoj! Stojím teď\nna Olympijském stadionu."
        },
        {
          "start": 8.94,
          "end": 13.32,
          "text": "Olympijské hry\nse tu ale nikdy nekonaly,"
        },
        {
          "start": 13.78,
          "end": 17.42,
          "text": "přesto tu stále najdete\nolympijské heslo:"
        },
        {
          "start": 18.22,
          "end": 20.78,
          "text": "Citius, Altius, Fortius,\ncož znamená:"
        },
        {
          "start": 20.78,
          "end": 23.96,
          "text": "silněji, rychleji, výše."
        },
        {
          "start": 23.96,
          "end": 29.56,
          "text": "Doporučuji navštívit\ntuto úžasnou stavbu,"
        },
        {
          "start": 29.56,
          "end": 34.2,
          "text": "která vznikla\nv letech 1926 až 1928."
        },
        {
          "start": 34.9,
          "end": 40.84,
          "text": "Sloužila hlavně jako místo\npro cvičení a trénink"
        },
        {
          "start": 40.84,
          "end": 44.9,
          "text": "německých sportovců,\nkteří se připravovali"
        },
        {
          "start": 44.9,
          "end": 47.1,
          "text": "na olympijské hry\nv Los Angeles."
        },
        {
          "start": 47.82,
          "end": 52.2,
          "text": "Od té doby stadion prošel\nmnoha rekonstrukcemi."
        },
        {
          "start": 52.2,
          "end": 55.4,
          "text": "Během let\nbyl rozšířen"
        },
        {
          "start": 55.4,
          "end": 59.2,
          "text": "a dnes se tu konají hlavně\nfotbalové zápasy,"
        },
        {
          "start": 59.42,
          "end": 61.26,
          "text": "zápasy amerického fotbalu"
        },
        {
          "start": 61.26,
          "end": 64.34,
          "text": "a motocyklové závody,"
        },
        {
          "start": 64.34,
          "end": 68.48,
          "text": "které jsou prý\nhodně divoké"
        },
        {
          "start": 68.48,
          "end": 72.76,
          "text": "a vzrušující. A"
        },
        {
          "start": 72.76,
          "end": 75.68,
          "text": "musím se sem vrátit\na na takový závod se podívat."
        },
        {
          "start": 75.98,
          "end": 79.02,
          "text": "Doporučuji také procházku\npo tomto areálu,"
        },
        {
          "start": 79.02,
          "end": 82.5,
          "text": "který je plný\nsportovních zařízení."
        },
        {
          "start": 82.5,
          "end": 87.78,
          "text": "Můžete také dojet na kole\nk nedaleké Odře."
        },
        {
          "start": 87.78,
          "end": 92.08,
          "text": "A než začnete, nezapomeňte\nna kávu a dort"
        },
        {
          "start": 92.08,
          "end": 95.24000000000001,
          "text": "v Mała Czarna,\nhned u vstupu"
        },
        {
          "start": 95.24000000000001,
          "end": 98.22,
          "text": "do olympijského areálu. A"
        },
        {
          "start": 98.88,
          "end": 101.3,
          "text": "dejte si kávu a dort\na pak nezapomeňte"
        },
        {
          "start": 101.3,
          "end": 103.94,
          "text": "jít běhat,\nabyste to vykompenzovali."
        },
        {
          "start": 104.5,
          "end": 106.66,
          "text": "Uvidíme se\nu dalšího videa."
        },
        {
          "start": 107.22,
          "end": 108.2,
          "text": "Do widzenia!"
        }
      ]
    }
