      "cueCount": 22,
      "cues": [
        {
          "start": 1.65,
          "end": 2.29,
          "text": "Cześć!"
        },
        {
          "start": 2.63,
          "end": 7.01,
          "text": "שלום לכולם, אנחנו נמצאים ברובע ארבע הדתות."
        },
        {
          "start": 7.01,
          "end": 10.4,
          "text": "וכשאני אומר ארבע דתות, אני מתכוון"
        },
        {
          "start": 10.4,
          "end": 13.93,
          "text": "לשלושה זרמים שונים של נצרות וליהדות."
        },
        {
          "start": 14.47,
          "end": 18.6,
          "text": "ניתן למצוא ברובע הזה שלוש כנסיות מזרמים שונים,"
        },
        {
          "start": 18.6,
          "end": 21.73,
          "text": "וגם בית כנסת החסידה הלבנה,"
        },
        {
          "start": 21.91,
          "end": 26.27,
          "text": "שהוא בית כנסת מדהים\nשביקרנו בו במהלך יום כיפור."
        },
        {
          "start": 29.43,
          "end": 34.3,
          "text": "האזור הזה משופע בפסאז׳ים, מסעדות ובתי קפה."
        },
        {
          "start": 34.3,
          "end": 40.6,
          "text": "אני למשל נמצא כרגע באחד הפסאז׳ים\nהמפורסמים שנקרא פוקויהוף,"
        },
        {
          "start": 40.6,
          "end": 45.43,
          "text": "בתרגום חופשי, החצר של פוקוי."
        },
        {
          "start": 45.43,
          "end": 49,
          "text": "מעבר למבנה המרשים ארכיטקטונית"
        },
        {
          "start": 49,
          "end": 52.63,
          "text": "והאריחים הצבעוניים היפהפיים שיש פה,"
        },
        {
          "start": 52.63,
          "end": 55,
          "text": "יש כאן בית קפה סטארבקס,"
        },
        {
          "start": 55,
          "end": 57.71,
          "text": "בית קפה שרלוט, שהוא בית קפה צרפתי."
        },
        {
          "start": 57.71,
          "end": 60.5,
          "text": "ישנו גם בית קפה ממש בכניסה לפסאז׳ שנקרא פוקוי,"
        },
        {
          "start": 60.5,
          "end": 62.73,
          "text": "שהוא גם מומלץ."
        },
        {
          "start": 62.73,
          "end": 65.49,
          "text": "יש כאן ברים ומסעדות."
        },
        {
          "start": 65.49,
          "end": 69.3,
          "text": "ממש לידנו נמצא רחוב שנקרא אנטונייגו,"
        },
        {
          "start": 69.3,
          "end": 74.93,
          "text": "שזה רחוב קטן וארוך מלא במסעדות ובתי קפה."
        },
        {
          "start": 74.93,
          "end": 78.45,
          "text": "מאוד מאוד מומלץ לבקר באזור הזה."
        },
        {
          "start": 78.45,
          "end": 81,
          "text": "אז נתראה בסרטון הבא."
        },
        {
          "start": 81,
          "end": 83.8,
          "text": "Do widzenia!"
        }
      ],
