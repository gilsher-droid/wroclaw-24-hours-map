      "cueCount": 29,
      "cues": [
        {
          "start": 1.07,
          "end": 1.59,
          "text": "Więc,"
        },
        {
          "start": 1.59,
          "end": 6.73,
          "text": "Stoję tutaj w dzielnicy nazywanej"
        },
        {
          "start": 6.73,
          "end": 10.25,
          "text": "Dzielnicą Czterech Religii."
        },
        {
          "start": 10.97,
          "end": 14.4,
          "text": "Kiedy mówię o czterech religiach, mam na myśli"
        },
        {
          "start": 14.4,
          "end": 17.31,
          "text": "trzy różne nurty chrześcijaństwa oraz judaizm."
        },
        {
          "start": 18.11,
          "end": 23.2,
          "text": "W tej pięknej dzielnicy\nznajdziecie trzy różne kościoły"
        },
        {
          "start": 23.2,
          "end": 27.45,
          "text": "służące trzem wyznaniom chrześcijańskim,"
        },
        {
          "start": 27.45,
          "end": 30.9,
          "text": "a także piękną Synagogę Pod Białym Bocianem."
        },
        {
          "start": 30.9,
          "end": 35.8,
          "text": "Odwiedziliśmy ją podczas ostatniego Jom Kipur"
        },
        {
          "start": 35.8,
          "end": 40.19,
          "text": "i było to naprawdę poruszające doświadczenie."
        },
        {
          "start": 40.19,
          "end": 45.5,
          "text": "Ponadto ta dzielnica jest\npełna pasaży i małych uliczek"
        },
        {
          "start": 45.5,
          "end": 49.3,
          "text": "z kawiarniami i restauracjami."
        },
        {
          "start": 49.3,
          "end": 53.11,
          "text": "Stoję teraz w jednym ze\nsłynnych pasaży o nazwie"
        },
        {
          "start": 53.11,
          "end": 57.1,
          "text": "Pokoyhof. W tłumaczeniu\noznacza to ogród Pokoya."
        },
        {
          "start": 57.1,
          "end": 61.8,
          "text": "Tuż przy wejściu do pasażu jest\nbardzo miła kawiarnia Pokoy."
        },
        {
          "start": 61.8,
          "end": 66.7,
          "text": "Gdy wejdziecie do pasażu,\nnajpierw zachwyci was"
        },
        {
          "start": 66.7,
          "end": 71.19,
          "text": "ten budynek i dziedziniec, na którym stoję,"
        },
        {
          "start": 71.19,
          "end": 76.55,
          "text": "z piękną architekturą i kolorowymi płytkami."
        },
        {
          "start": 76.55,
          "end": 79.4,
          "text": "W tym pasażu znajdziecie Starbucks."
        },
        {
          "start": 79.4,
          "end": 84.7,
          "text": "Jest tu także Charlotte, francuska kawiarnia."
        },
        {
          "start": 84.7,
          "end": 90.79,
          "text": "Znajdziecie tu bary i inne restauracje."
        },
        {
          "start": 90.79,
          "end": 96.29,
          "text": "Tuż obok jest słynna\nuliczka świętego Antoniego,"
        },
        {
          "start": 96.29,
          "end": 100.3,
          "text": "również pełna restauracji i kawiarni."
        },
        {
          "start": 100.3,
          "end": 106.27,
          "text": "Polecam przyjść i pospacerować po\ntych pięknych pasażach i uliczkach."
        },
        {
          "start": 106.27,
          "end": 110.95,
          "text": "Innym bardzo ciekawym pasażem\njest podwórko z neonami."
        },
        {
          "start": 111.49,
          "end": 116.6,
          "text": "Polecam odwiedzić je wieczorem,"
        },
        {
          "start": 116.6,
          "end": 119.79,
          "text": "kiedy wszystkie neony świecą\njasnymi, pięknymi kolorami."
        },
        {
          "start": 120.35,
          "end": 121.77,
          "text": "Do zobaczenia w naszym następnym filmie."
        },
        {
          "start": 122.63,
          "end": 123.8,
          "text": "Do widzenia!"
        }
      ],
