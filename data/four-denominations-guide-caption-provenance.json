      "srtSHA256": "200d0134d03c9833113da904aa3ab84cea230939e8578ae64274bfc3b6799d75",
      "cueCount": 29,
      "cues": [
        {
          "start": 1.07,
          "end": 1.59,
          "text": "Also,"
        },
        {
          "start": 1.59,
          "end": 6.73,
          "text": "Ich stehe hier in einem Viertel, das"
        },
        {
          "start": 6.73,
          "end": 10.25,
          "text": "Viertel der vier Religionen genannt wird."
        },
        {
          "start": 10.97,
          "end": 14.4,
          "text": "Mit vier Religionen meine ich eigentlich"
        },
        {
          "start": 14.4,
          "end": 17.31,
          "text": "drei verschiedene christliche\nKonfessionen und das Judentum."
        },
        {
          "start": 18.11,
          "end": 23.2,
          "text": "In diesem schönen Viertel gibt\nes drei verschiedene Kirchen"
        },
        {
          "start": 23.2,
          "end": 27.45,
          "text": "für drei christliche Konfessionen"
        },
        {
          "start": 27.45,
          "end": 30.9,
          "text": "sowie die schöne Synagoge zum Weißen Storch."
        },
        {
          "start": 30.9,
          "end": 35.8,
          "text": "Wir besuchten diese Synagoge\nam letzten Jom Kippur,"
        },
        {
          "start": 35.8,
          "end": 40.19,
          "text": "und es war wirklich ein bewegendes Erlebnis."
        },
        {
          "start": 40.19,
          "end": 45.5,
          "text": "Außerdem ist dieses Viertel voller\nPassagen und kleiner Straßen"
        },
        {
          "start": 45.5,
          "end": 49.3,
          "text": "mit Cafés und Restaurants."
        },
        {
          "start": 49.3,
          "end": 53.11,
          "text": "Ich stehe gerade in einer\nder bekannten Passagen namens"
        },
        {
          "start": 53.11,
          "end": 57.1,
          "text": "Pokoyhof. Übersetzt bedeutet\ndas Garten von Pokoy."
        },
        {
          "start": 57.1,
          "end": 61.8,
          "text": "Direkt am Eingang gibt es ein\nsehr schönes Café namens Pokoy."
        },
        {
          "start": 61.8,
          "end": 66.7,
          "text": "Wenn man die Passage\nbetritt, beeindruckt zunächst"
        },
        {
          "start": 66.7,
          "end": 71.19,
          "text": "dieses Gebäude und der Hof, in dem ich stehe,"
        },
        {
          "start": 71.19,
          "end": 76.55,
          "text": "mit schöner Architektur und farbigen Fliesen."
        },
        {
          "start": 76.55,
          "end": 79.4,
          "text": "In dieser Passage gibt es Starbucks."
        },
        {
          "start": 79.4,
          "end": 84.7,
          "text": "Hier ist auch Charlotte,\nein französisches Café."
        },
        {
          "start": 84.7,
          "end": 90.79,
          "text": "Außerdem gibt es Bars und weitere Restaurants."
        },
        {
          "start": 90.79,
          "end": 96.29,
          "text": "Gleich nebenan liegt die\nbekannte kleine Straße Antoniego,"
        },
        {
          "start": 96.29,
          "end": 100.3,
          "text": "die ebenfalls voller\nRestaurants und Cafés ist."
        },
        {
          "start": 100.3,
          "end": 106.27,
          "text": "Ich empfehle, hierherzukommen und durch die\nschönen Passagen und Straßen zu schlendern."
        },
        {
          "start": 106.27,
          "end": 110.95,
          "text": "Eine weitere interessante Passage\nist der Hof mit den Neonschildern."
        },
        {
          "start": 111.49,
          "end": 116.6,
          "text": "Ich empfehle einen Besuch am Abend,"
        },
        {
          "start": 116.6,
          "end": 119.79,
          "text": "wenn alle Neonschilder in\nschönen Farben hell leuchten."
        },
        {
          "start": 120.35,
          "end": 121.77,
          "text": "Wir sehen uns in unserem nächsten Video."
        },
        {
          "start": 122.63,
          "end": 123.8,
          "text": "Do widzenia!"
        }
      ],
      "allCueTextsAndTimesVerified": true,
      "timingToleranceSeconds": 0.15,
      "verificationTime": "2026-10-20T14:24:09.376923+00:00",
      "evidence": [
