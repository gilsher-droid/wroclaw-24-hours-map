      "cues": [
        {
          "start": 2.22,
          "end": 4.2,
          "text": "Cześć. Hallo!"
        },
        {
          "start": 4.92,
          "end": 9.26,
          "text": "Wir stehen vor\ndem Multimedia-Brunnen."
        },
        {
          "start": 9.94,
          "end": 17.2,
          "text": "Dieser Brunnen hat 300 Wasserfontänen\nund Feuerdüsen."
        },
        {
          "start": 17.88,
          "end": 21.6,
          "text": "Der Brunnen erstreckt sich\nüber etwa einen Hektar."
        },
        {
          "start": 22.24,
          "end": 28.6,
          "text": "Prüft vor eurer Ankunft\ndie Zeiten der Brunnenshows."
        },
        {
          "start": 28.6,
          "end": 36.12,
          "text": "Verpasst nicht das wunderbare Schauspiel\naus Musik, Licht und Wasser."
        },
        {
          "start": 37.44,
          "end": 44.9,
          "text": "Kommt sowohl bei Tageslicht\nals auch am Abend oder bei Nacht."
        },
        {
          "start": 44.9,
          "end": 48.46,
          "text": "So erlebt ihr\nzwei ganz unterschiedliche Eindrücke."
        },
        {
          "start": 49.04,
          "end": 52.24,
          "text": "Bis zu unserer nächsten Station.\nAuf Wiedersehen!"
        }
      ],
