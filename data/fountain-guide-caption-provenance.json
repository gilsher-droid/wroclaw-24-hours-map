    "cs": {
      "edition": "en",
      "cues": [
        {
          "start": 2.22,
          "end": 4.2,
          "text": "Cześć. Ahoj!"
        },
        {
          "start": 4.92,
          "end": 9.26,
          "text": "Stojíme před\nmultimediální fontánou."
        },
        {
          "start": 9.94,
          "end": 17.2,
          "text": "Fontána má 300 vodních trysek\na také ohnivé trysky."
        },
        {
          "start": 17.88,
          "end": 21.6,
          "text": "Fontána zabírá plochu\npřibližně jednoho hektaru."
        },
        {
          "start": 22.24,
          "end": 28.6,
          "text": "Před příjezdem si zkontrolujte\nčasy představení fontány."
        },
        {
          "start": 28.6,
          "end": 36.12,
          "text": "Nenechte si ujít nádhernou podívanou\ns hudbou, světly a vodou."
        },
        {
          "start": 37.44,
          "end": 44.9,
          "text": "Přijďte za denního světla\ni večer nebo v noci."
        },
        {
          "start": 44.9,
          "end": 48.46,
          "text": "Získáte tak\nzcela odlišný zážitek."
        },
        {
          "start": 49.04,
          "end": 52.24,
          "text": "Uvidíme se na další zastávce.\nNa shledanou!"
        }
      ],
      "srtSHA256": "2a302f6c0e3302f14ce798d5c4718b04c961e9b2c4c2b8766ea68d18b25f9896",
