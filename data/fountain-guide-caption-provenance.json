        {
          "start": 2.22,
          "end": 4.2,
          "text": "Cześć. Hi!"
        },
        {
          "start": 4.92,
          "end": 9.26,
          "text": "We are standing in front of\nthe Multimedia Fountain."
        },
        {
          "start": 9.94,
          "end": 17.2,
          "text": "This fountain has 300 water jets\nand fire jets."
        },
        {
          "start": 17.88,
          "end": 21.6,
          "text": "The fountain covers\napproximately one hectare."
        },
        {
          "start": 22.24,
          "end": 28.6,
          "text": "Check the schedule of the fountain shows\nbefore you arrive."
        },
        {
          "start": 28.6,
          "end": 36.12,
          "text": "Do not miss the wonderful show\nof music, lights and water."
        },
        {
          "start": 37.44,
          "end": 44.9,
          "text": "Visit both in daylight\nand in the evening or at night."
        },
        {
          "start": 44.9,
          "end": 48.46,
          "text": "You will have\na completely different experience."
        },
        {
          "start": 49.04,
          "end": 52.24,
          "text": "See you at our next stop.\nDo widzenia!"
        }
      ],
