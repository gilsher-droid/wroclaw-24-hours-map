    "pl": {
      "edition": "en",
      "cues": [
        {
          "start": 2.22,
          "end": 4.2,
          "text": "Cześć!"
        },
        {
          "start": 4.92,
          "end": 9.26,
          "text": "Stoimy przed\nFontanną Multimedialną."
        },
        {
          "start": 9.94,
          "end": 17.2,
          "text": "Fontanna ma 300 dysz wodnych\noraz dysze ogniowe."
        },
        {
          "start": 17.88,
          "end": 21.6,
          "text": "Fontanna zajmuje powierzchnię\nokoło jednego hektara."
        },
        {
          "start": 22.24,
          "end": 28.6,
          "text": "Przed przyjazdem sprawdźcie\nharmonogram pokazów fontanny."
        },
        {
          "start": 28.6,
          "end": 36.12,
          "text": "Nie przegapcie wspaniałego pokazu\nmuzyki, świateł i wody."
        },
        {
          "start": 37.44,
          "end": 44.9,
          "text": "Przyjdźcie zarówno za dnia,\njak i wieczorem lub nocą."
        },
        {
          "start": 44.9,
          "end": 48.46,
          "text": "Dzięki temu czekają was\nzupełnie różne wrażenia."
        },
        {
          "start": 49.04,
          "end": 52.24,
          "text": "Do zobaczenia na następnym przystanku.\nDo widzenia!"
        }
      ],
