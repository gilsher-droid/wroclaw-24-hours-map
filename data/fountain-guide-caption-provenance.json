    "he": {
      "edition": "he",
      "cues": [
        {
          "start": 1.6,
          "end": 2.88,
          "text": "צ׳שץ׳!"
        },
        {
          "start": 3.76,
          "end": 6.92,
          "text": "ברוכים הבאים למזרקת המולטימדיה."
        },
        {
          "start": 7.36,
          "end": 13.56,
          "text": "במזרקה יש שלוש מאות סילוני מים\nוגם סילוני אש."
        },
        {
          "start": 14.3,
          "end": 23.06,
          "text": "המזרקה מציגה מופעים מרהיבים\nשמשלבים מים, מוזיקה ואורות."
        },
        {
          "start": 23.48,
          "end": 30.98,
          "text": "מומלץ לבדוק את לוח הזמנים\nומתי המופעים מתקיימים."
        },
        {
          "start": 31.5,
          "end": 35.2,
          "text": "המזרקה נמצאת במרכז מבנה הפרגולה,"
        },
        {
          "start": 35.2,
          "end": 37.82,
          "text": "שדיברנו עליו בפוסט אחר."
        },
        {
          "start": 38.36,
          "end": 43.56,
          "text": "מומלץ להגיע גם באור יום\nוגם בערב,"
        },
        {
          "start": 43.56,
          "end": 46.3,
          "text": "כדי לקבל חוויה שונה."
        },
        {
          "start": 46.9,
          "end": 50.54,
          "text": "להתראות בתחנה הבאה!"
        }
      ],
