":"2be35a57fc9927b285e55432ea0ff18fd460b0dff822e3d7f1002a4bd1a63d42","zyjnia-bwa-wroclaw":"f4c65f2bde60b1262829d749cb7143f12cd4af4f341555b7096dc69b438360be"},"places":{"slodowa":{"id":"slodowa","localName":"Wyspa Słodowa","name":{"he":"אי סלודובה","en":"Słodowa Island","pl":"Wyspa Słodowa","de":"Insel Słodowa","cs":"Ostrov Słodowa"},"description":{"he":"אי ירוק בלב זרועות האודר, עם מדשאות, עצים וגדות המשמשות להליכה ולמפגש. הגשרים להולכי רגל מחברים אותו לגדות ולאיים הסמוכים. תמונות הביקור שלנו מציגות את שלט האי, המים והעצים באור ערב, ואת גשר הולכי הרגל כחלק מהסביבה. תחנת מילוי המים והברים הסמוכים הם מקומות נפרדים. בתמונות הנוספות נראים גדת האי וסירת הבר המוארת שבסביבה.\nWyspa Słodowa","en":"A green island between branches of the Oder, with lawns, trees and banks for walking and meeting friends. Footbridges connect it to nearby banks and islands. Our evening visit photos show the island sign, water, trees and a footbridge in context. The water-refill point and nearby bars remain separate places. Additional photographs show the island bank and an illuminated floating bar nearby.","pl":"Zielona wyspa między odnogami Odry, z trawnikami, drzewami i brzegami sprzyjającymi spacerom oraz spotkaniom. Kładki łączą ją z pobliskimi nabrzeżami i wyspami. Nasze wieczorne zdjęcia pokazują tablicę wyspy, wodę, drzewa i kładkę w otoczeniu. Punkt poboru wody i pobliskie bary pozostają osobnymi miejscami. Dodatkowe zdjęcia pokazują brzeg wyspy i oświetlony bar na barce w pobliżu.","de":"Eine grüne Insel zwischen Oderarmen, mit Rasenflächen, Bäumen und Ufern zum Spazierengehen und Treffen. Fußgängerbrücken verbinden sie mit den benachbarten Ufern und Inseln. Unsere abendlichen Besuchsfotos zeigen das Inselschild, Wasser, Bäume und eine Brücke im Umfeld. Trinkwasserstelle und nahe Bars bleiben eigenständige Orte. Weitere Aufnahmen zeigen das Inselufer und eine beleuchtete schwimmende Bar in der Nähe.","cs":"Zelený ostrov mezi rameny Odry s trávníky, stromy a břehy pro procházky a setkávání. Lávky jej propojují s okolními nábřežími a ostrovy. Naše večerní fotografie ukazují tabuli ostrova, vodu, stromy a lávku v okolní krajině. Pítko a blízké bary zůstávají samostatnými místy. Další fotografie ukazují břeh ostrova a osvětlený plovoucí bar poblíž."},"location":{"countryCode":"PL","regionId":"lower-silesia","cityId":"wroclaw","coordinates":{"lat":51.1169,"lng":17.03737}},"categories":["river"],"sourceUrls":[],"aliases":[],"sourceRecords":[{"productId":"wroclaw-four-days","kind":"route-stop","sourceId":"slodowa"}],"coordinateCandidates":[{"productId":"wroclaw-four-days","sourceId":"slodowa","lat":51.1169,"lng":17.03737}],"status":"published","editorialPriority":null,"taxonomy":{"categories":["river"],"tags":[]},"suitability":{"recommendedFor":[],"walkingIntensity":null,"familyFriendly":null,"couples":null,"solo":null,"romantic":null,"indoorOutdoor":null,"rainFriendly":null,"budgetLevel":null,"accessibility":{"level":null,"notes":null}},"visit":{"durationMinutes":null,"bestTimeOfDay":[],"seasonalSuitability":[],"openingHoursNotes":null},"links":{"website":"https://zzm.wroc.pl/obiektyzzmcp/wyspa-slodowa/","navigation":{"googleMaps":"https://www.google.com/maps/search/?api=1&query=51.1169%2C17.03737","appleMaps":"https://maps.apple.com/?ll=51.1169,17.03737&q=Wyspa%20S%C5%82odowa"},"socialProfileFallback":false},"transport":{"carRequired":null,"publicTransportNotes":null,"parkingNotes":null,"drivingTimeFromWroclawMinutes":null},"languages":["he","en","pl","de","cs"],"provenance":{"verifiedAt":"2026-10-19","factualSources":[{"url":"https://zzm.wroc.pl/obiektyzzmcp/wyspa-slodowa/","checked":"2026-10-19","supports":["IslandbetweenOderbranches","Publicrecreational lawns/trees","Footbridgeconnections","Socialmeetingandculturaluse"]},{"url":"https://visitwroclaw.eu/poznaj-i-zwiedzaj/atrakcje/wyspa-slodowa","checked":"2026-10-19","supports":["Tourismidentity"]}],"personalMediaPermission":false,"refresh20261020":{"sourcePhotos":21,"selectedNew":2,"preservedOld":4,