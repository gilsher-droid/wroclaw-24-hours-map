At":"2026-10-19T18:44:13.499Z"},{"platform":"instagram","language":"pl","url":"https://www.instagram.com/p/Der6KRljCyx/","verifiedAt":"2026-10-19T18:32:37.107Z"},{"platform":"instagram","language":"en","url":"https://www.instagram.com/wroclaw.lowersilesia/p/Der-JfPH59j/","verifiedAt":"2026-10-19T19:07:23.419Z"},{"platform":"instagram","language":"he","url":"https://www.instagram.com/wroclaw.lowersilesia.he/p/DesCUoUn8Fs/","verifiedAt":"2026-10-19T19:44:36.184Z"},{"platform":"facebook","language":"he","url":"https://facebook.com/permalink.php?story_fbid=pfbid073mMTKirFRPWmrUZetdznzTzVQf5hJS1d6jkAoeE6tXn7BB9cnEZL3LegRQDrKoSl&id=61591964083308","verifiedAt":"2026-10-19T19:54:41.250Z"},{"platform":"facebook","language":"en","url":"https://www.facebook.com/permalink.php?story_fbid=pfbid0M1Scc96KkK1hWEzeduag3dyNj3W2yrsutuLLr6tm9S3exu2jtQ98zXwXckmZsKmMl&id=61595036942289","verifiedAt":"2026-10-19T13:16:37.446Z"},{"platform":"facebook","language":"cs","url":"https://www.facebook.com/permalink.php?story_fbid=pfbid0ngQumK9b8tSR51qva9E3FJaA1geZPfhbn5CnB6Nz4oKWtes9sb5efF3PBrvvqvdDl&id=61594716405964","verifiedAt":"2026-10-19T13:16:40.950Z"},{"platform":"facebook","language":"pl","url":"https://facebook.com/permalink.php?story_fbid=pfbid02qG93ZBdYLnCaFDxv55C1NSefUeXtj8syhFPwsx9DSU1656TY5AFfRnjXLAsveQiyl&id=61595207664875","verifiedAt":"2026-10-19T13:16:44.616Z"}]},"hala":{"id":"hala","localName":"Hala Stulecia","name":{"he":"היכל המאה","en":"Centennial Hall","pl":"Hala Stulecia","de":"Jahrhunderthalle","cs":"Hala století"},"description":{"he":"היכל המאה הוא מבנה משנת 1913 בתכנון מקס ברג, ואתר מורשת עולמית של אונסק״ו. בגלריה מבטים על החזית והכיפה, רחבת האיגליצה וההיכל מעבר לבריכת המזרקה. אפשר לשלב ביקור עם הפרגולה וביתן ארבע הכיפות הסמוכים. הכניסה לפנים ההיכל תלויה בלוח האירועים ובזמינות הביקורים; בדקו באתר הרשמי לפני ההגעה.","en":"Designed by Max Berg and opened in 1913, Centennial Hall is a UNESCO World Heritage site. Our gallery shows its façade and dome, the Iglica plaza and views across the fountain basin. Combine it with the nearby Pergola and Four Domes Pavilion. Interior access depends on events and visitor availability; check the official site before arriving.","pl":"Hala Stulecia, zaprojektowana przez Maxa Berga i otwarta w 1913 roku, jest obiektem światowego dziedzictwa UNESCO. Galeria pokazuje elewację i kopułę, plac z Iglicą oraz widoki zza niecki fontanny. Wizytę można połączyć z pobliską Pergolą i Pawilonem Czterech Kopuł. Dostęp do wnętrza zależy od wydarzeń i dostępności zwiedzania; sprawdź oficjalną stronę przed przyjazdem.","de":"Die von Max Berg entworfene und 1913 eröffnete Jahrhunderthalle gehört zum UNESCO-Welterbe. Unsere Galerie zeigt Fassade und Kuppel, den Platz mit der Iglica und Blicke über das Wasserbecken. Ein Besuch lässt sich mit der nahen Pergola und dem Vier-Kuppel-Pavillon verbinden. Der Innenzugang hängt von Veranstaltungen und Besichtigungsmöglichkeiten ab; prüfen Sie vorher die offizielle Website.","cs":"Hala století, navržená Maxem Bergem a otevřená v roce 1913, je památkou světového dědictví UNESCO. Galerie ukazuje průčelí a kupoli, prostranství s Iglicou a pohledy přes nádrž fontány. Návštěvu lze spojit s nedalekou Pergolou a Pavilonem čtyř kupolí. Přístup dovnitř závisí na akcích a dostupnosti prohlídek; před cestou ověřte oficiální web."},"location":{"countryCode":"PL","regionId":"lower-silesia","cityId":"wroclaw","coordinates":{"lat":51.10689,"lng":17.07733},"address":{"street":"Wystawowa 1","postalCode":"51-618","city":"Wrocław","country":"Poland"}},"categories":["architecture"],"sourceUrls":[],"aliases":[],"sourceRecords":[{"productId":"wroclaw-four-days","kind":"route-stop","sourceId":"hala"}],"coordinateCandidates":[{"productId":"wroclaw-four-days","sourceId":"hala","lat":51.10689,"lng":17.07733}],"status":"published","editorialPriority":"high","taxonomy":{"categories":["architecture"],"tags":["architecture","unesco","historical","photography"]},"suitability":{"recommendedFor":[],"walkingInte