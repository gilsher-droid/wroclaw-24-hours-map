        {
          "start": 3.79,
          "end": 8.7,
          "text": "Ich stehe an dem Ort, an dem\nWrocław seinen Ursprung hat,"
        },
        {
          "start": 8.7,
          "end": 12.49,
          "text": "Ostrów Tumski, der Dominsel."
        },
        {
          "start": 13.51,
          "end": 17.2,
          "text": "Zwischen all diesen beeindruckenden\nKirchen und Klöstern"
        },
        {
          "start": 17.2,
          "end": 21.85,
          "text": "und schönen Gebäuden liegt\nein Stück grünes Paradies."
        },
        {
          "start": 22.35,
          "end": 27.77,
          "text": "Ich meine den Botanischen Garten\nvon Wrocław, direkt hinter mir."
        },
        {
          "start": 27.77,
          "end": 31.2,
          "text": "Er gehört zur Universität Wrocław."
        },
        {
          "start": 31.2,
          "end": 34.79,
          "text": "Ich empfehle, hierherzukommen und"
        },
        {
          "start": 34.79,
          "end": 38.53,
          "text": "die schönen Bäume, Blumen\nund Pflanzen zu genießen."
        },
        {
          "start": 38.53,
          "end": 42.53,
          "text": "Geht auf all diesen schönen Wegen spazieren,"
        },
        {
          "start": 42.53,
          "end": 45.7,
          "text": "zwischen den Gärten, und\ngenießt einen großen See"
        },
        {
          "start": 45.7,
          "end": 49.8,
          "text": "mit einer wunderschönen Brücke\nund einem Springbrunnen."
        },
        {
          "start": 49.8,
          "end": 54.63,
          "text": "Es ist ein sehr romantischer Ort,\ndaher empfehle ich besonders Paaren,"
        },
        {
          "start": 54.63,
          "end": 57,
          "text": "durch diesen Garten zu schlendern."
        },
        {
          "start": 57,
          "end": 61.33,
