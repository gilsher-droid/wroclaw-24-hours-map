      "cues": [
        {
          "start": 0.9,
          "end": 2.9,
          "text": "Dzień dobry. Hallo zusammen."
        },
        {
          "start": 3.48,
          "end": 5.6,
          "text": "Ich stehe auf dieser schönen Brücke."
        },
        {
          "start": 6.06,
          "end": 9.4,
          "text": "Auf der Brücke seht ihr Liebesschlösser."
        },
        {
          "start": 9.58,
          "end": 12.0,
          "text": "Das ist wirklich ein sehr romantischer Ort."
        },
        {
          "start": 12.5,
          "end": 17.12,
          "text": "Wir sind im Szczytnicki-Park,\nin einem Garten namens Japanischer Garten."
        },
        {
          "start": 17.3,
          "end": 22.15,
          "text": "Dieser Garten wurde 1916 angelegt,\nals Teil der Ausstellung in dieser Gegend."
        },
        {
          "start": 22.16,
          "end": 27.2,
          "text": "Er entstand gemeinsam\nmit japanischen Landschaftsarchitekten."
        },
        {
          "start": 28.64,
          "end": 32.36,
          "text": "Ich empfehle einen Besuch sehr.\nEs ist ein wunderschöner Garten."
        },
        {
          "start": 32.62,
          "end": 37.5,
          "text": "Die Pflanzen, Goldfische und Karpfen im Wasser\nsind wirklich beeindruckend."
        },
        {
          "start": 38.52,
          "end": 41.5,
          "text": "Genießt die ruhige und entspannte Atmosphäre."
        },
        {
          "start": 42.0,
          "end": 43.1,
          "text": "Auf Wiedersehen."
        }
      ],
