    "cs": {
      "edition": "en",
      "cues": [
        {
          "start": 0.9,
          "end": 2.9,
          "text": "Dzień dobry. Ahoj všem."
        },
        {
          "start": 3.48,
          "end": 5.6,
          "text": "Stojím na tomto krásném mostě."
        },
        {
          "start": 6.06,
          "end": 9.4,
          "text": "Na mostě vidíte zámky lásky."
        },
        {
          "start": 9.58,
          "end": 12.0,
          "text": "Je to opravdu velmi romantické místo."
        },
        {
          "start": 12.5,
          "end": 17.12,
          "text": "Jsme v parku Szczytnicki,\nv zahradě zvané Japonská zahrada."
        },
        {
          "start": 17.3,
          "end": 22.15,
          "text": "Zahrada vznikla v roce 1916\njako součást výstavy v této oblasti."
        },
        {
          "start": 22.16,
          "end": 27.2,
          "text": "Vznikla ve spolupráci\ns japonskými krajinnými architekty."
        },
        {
          "start": 28.64,
          "end": 32.36,
          "text": "Návštěvu opravdu doporučuji.\nJe to krásná zahrada."
        },
        {
          "start": 32.62,
          "end": 37.5,
          "text": "Rostliny, zlaté rybky a kapři ve vodě\njsou opravdu úžasní."
        },
        {
          "start": 38.52,
          "end": 41.5,
          "text": "Užijte si klidnou a odpočinkovou atmosféru."
        },
        {
          "start": 42.0,
          "end": 43.1,
          "text": "Na shledanou."
        }
      ],
