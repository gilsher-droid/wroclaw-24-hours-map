    "he": {
      "edition": "he",
      "cues": [
        {
          "start": 0,
          "end": 2.8,
          "text": "דז׳ין דוברי. שלום לכולם."
        },
        {
          "start": 3.36,
          "end": 5.95,
          "text": "אני נמצא עכשיו על הגשר המקסים הזה."
        },
        {
          "start": 6.3,
          "end": 9.15,
          "text": "אתם יכולים לראות פה גם את מנעולי האהבה."
        },
        {
          "start": 10,
          "end": 13.5,
          "text": "בתוך פארק שצ׳יטניצקי, באזור שנקרא הגן היפני."
        },
        {
          "start": 14.4,
          "end": 18.85,
          "text": "הגן הזה הוקם במסגרת התערוכה\nשהייתה כאן בשנת 1916."
        },
        {
          "start": 19.96,
          "end": 22.0,
          "text": "בסיוע של אדריכלים יפנים."
        },
        {
          "start": 22.5,
          "end": 30.95,
          "text": "לאורך השנים הגן הזה קצת נפגע בשיטפונות\nשחוותה העיר, ב־1997 בעיקר."
        },
        {
          "start": 30.98,
          "end": 33.2,
          "text": "אבל נפתח מחדש ב־1999."
        },
        {
          "start": 33.21,
          "end": 36.72,
          "text": "ואני מזמין אתכם לבקר בגן היפני המקסים הזה,"
        },
        {
          "start": 36.73,
          "end": 41.4,
          "text": "ליהנות מהצמחייה, מדגי הזהב\nודגי הקרפיון הענקיים"
        },
        {
          "start": 41.41,
          "end": 43.46,
          "text": "שנמצאים ושוחים כאן בתוך הבריכות."
        },
        {
          "start": 43.54,
          "end": 46.8,
          "text": "נתראה בתחנה הבאה."
        }
      ],
