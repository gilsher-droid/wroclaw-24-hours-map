    "pl": {
      "edition": "en",
      "cues": [
        {
          "start": 0.9,
          "end": 2.9,
          "text": "Dzień dobry. Witam wszystkich."
        },
        {
          "start": 3.48,
          "end": 5.6,
          "text": "Stoję na tym pięknym mostku."
        },
        {
          "start": 6.06,
          "end": 9.4,
          "text": "Na mostku widać kłódki miłości."
        },
        {
          "start": 9.58,
          "end": 12.0,
          "text": "To naprawdę bardzo romantyczne miejsce."
        },
        {
          "start": 12.5,
          "end": 17.12,
          "text": "Jesteśmy w Parku Szczytnickim,\nw ogrodzie zwanym Ogrodem Japońskim."
        },
        {
          "start": 17.3,
          "end": 22.15,
          "text": "Ogród założono w 1916 roku\njako część wystawy w tej okolicy."
        },
        {
          "start": 22.16,
          "end": 27.2,
          "text": "Powstał we współpracy\nz japońskimi architektami krajobrazu."
        },
        {
          "start": 28.64,
          "end": 32.36,
          "text": "Naprawdę polecam tu przyjechać.\nTo piękny ogród."
        },
        {
          "start": 32.62,
          "end": 37.5,
          "text": "Roślinność, złote rybki i karpie w wodzie\nsą naprawdę wspaniałe."
        },
        {
          "start": 38.52,
          "end": 41.5,
          "text": "Cieszcie się spokojną i relaksującą atmosferą."
        },
        {
          "start": 42.0,
          "end": 43.1,
          "text": "Do widzenia."
        }
      ],
      "srtSHA256": "c9a4e9c0e5acd012cfcf726ce1778f967e7f2866babf7545b6c1af1d6e393d9d",
      "status": "Published",
      "videoId": "anSJzrqzqqg",
